{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pon-hakushu",
  "main": "src/worker.tsx",
  "compatibility_date": "2026-07-27",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "pon-hakushu.yhay81.com",
      "custom_domain": true,
    },
  ],
  "triggers": {
    "crons": ["53 18 * * *"],
  },
  "observability": {
    "enabled": true,
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pon-hakushu",
      "database_id": "01f950c8-f61e-49ad-9d8f-ec34ff933933",
      "migrations_dir": "migrations",
    },
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
  },
}
